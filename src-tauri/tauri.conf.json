{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultForge Wallet",
  "version": "../package.json",
  "identifier": "com.vaultforge.wallet",
  "build": {
    "beforeDevCommand": "bun run prepare-tauri && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare-tauri && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VaultForge Wallet",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.publicnode.com https://api.coingecko.com; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "publisher": "VaultForge",
    "homepage": "https://github.com/kunningKing11/vaultforge",
    "category": "Finance",
    "shortDescription": "A local-first multichain self-custody wallet",
    "longDescription": "Create or import a wallet, view chain-backed balances, and sign and broadcast supported transactions locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/com.vaultforge.wallet.metainfo.xml": "linux/com.vaultforge.wallet.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/vaultforge-wallet.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "release": "2",
        "files": {
          "/usr/share/metainfo/com.vaultforge.wallet.metainfo.xml": "linux/com.vaultforge.wallet.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/vaultforge-wallet.svg": "icons/icon.svg"
        }
      }
    }
  }
}
