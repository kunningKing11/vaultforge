{
  "name": "vaultforge-wallet",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run check && vite --host 127.0.0.1 --port 1420",
    "prepare-tauri": "bun scripts/prepare-tauri-icons.mts",
    "build": "bun run check && vite build",
    "lint": "oxlint . && oxfmt --check . && bun run lint:test-order && bun run lint:icon-order",
    "lint:oxlint": "oxlint .",
    "lint:test-order": "bun scripts/lint-test-order.mts --check",
    "lint:test-order:fix": "bun scripts/lint-test-order.mts --fix",
    "lint:fix": "oxlint --fix . && oxfmt --write . && bun run lint:test-order:fix && bun run lint:icon-order:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test --parallel",
    "typecheck": "bun check --no-script",
    "check": "bun run lint && bun run typecheck",
    "preview": "vite preview",
    "prepare": "lefthook install",
    "hooks:check": "bash scripts/hook-checks.sh",
    "sync-cargo-version": "bun scripts/sync-cargo-version.mts",
    "tauri": "tauri",
    "icons:download": "bun scripts/download-icons.mts",
    "icons:check": "bun scripts/download-icons.mts --check",
    "lint:icon-order": "bun scripts/lint-icon-order.mts --check",
    "lint:icon-order:fix": "bun scripts/lint-icon-order.mts --fix && oxfmt --write src/icon-manifest.json"
  },
  "dependencies": {
    "@coinbase/cds-web": "^9.29.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "framer-motion": "^10.18.0",
    "qrcode": "^1.5.4",
    "react": "~19.1.10",
    "react-dom": "~19.1.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "bun@1.4.4"
}
