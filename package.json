{
  "name": "vaultforge-wallet",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run check && vite --host 127.0.0.1 --port 1420",
    "prepare-tauri": "bun scripts/prepare-tauri-icons.mts",
    "build": "bun run check && vite build",
    "lint": "oxlint . && oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "preview": "vite preview",
    "prepare": "lefthook install",
    "hooks:check": "bash scripts/hook-checks.sh",
    "sync-cargo-version": "bun scripts/sync-cargo-version.mts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@coinbase/cds-web": "^9.26.2",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "framer-motion": "^10.18.0",
    "qrcode": "^1.5.4",
    "react": "~19.1.2",
    "react-dom": "~19.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
